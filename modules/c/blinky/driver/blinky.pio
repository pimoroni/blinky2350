; Two state machines drive the LED matrix with no CPU intervention between
; scanlines. Splitting the work lets each SM pull from its own lean DMA stream,
; so the redundant per-frame timing/pin control that a single SM has to inline is
; gone: the pixel stream is pure packed pixel data and the tick stream is 14
; words.
;
; blinky_data  shifts one row's bit-plane (WIDTH bits) into the column shift
;              registers, then hands off to blinky_ctrl.
; blinky_ctrl  latches the plane, walks the row-select shift register, enables
;              the column drivers for the plane's BCD tick count, then releases
;              blinky_data to shift the next row.
;
; Scan order is phase-major: for each of the 14 BCD phases, all rows are scanned
; in turn. blinky_data streams packed planes in that order; blinky_ctrl streams
; one tick count per phase and reuses it across the phase's rows.
;
; pin ownership (no pin is driven by both state machines):
;   blinky_data:  16 column clock (sideset), 17 column data (out)
;   blinky_ctrl:  18 column latch, 19 column blank, 20 row data, 21 row clock
;                 (set pins, base 18, 4 pins: bit0 latch, bit1 blank,
;                  bit2 row data, bit3 row clock)
;
; handshake IRQ flags (4-7 are internal to the PIO block):
;   4 = DATA_READY  (data -> ctrl: the plane is in the shift register)
;   5 = SHIFT_NEXT  (ctrl -> data: shift the next row)


.program blinky_data
.side_set 1 opt                     ; column clock

; OSR: packed pixel planes, autopull, shift right, threshold 32. Each plane is
; WIDTH bits followed by padding to a 64-bit (2-word) boundary, so planes stay
; word-aligned. Y holds WIDTH-1, preloaded once (set's 5-bit immediate can't
; reach 38), and is copied to X to bound the per-plane bit loop.

.wrap_target
    mov x, y                side 0      ; reload column count (WIDTH - 1)
bit:
    out pins, 1             side 0 [3]  ; column data = pixel bit, clock low
    jmp x-- bit             side 1 [3]  ; clock high, shift the bit in
    out null, 25            side 0      ; discard padding to the 64-bit boundary
    irq set 4                           ; DATA_READY: plane loaded
    wait 1 irq 5                        ; wait for ctrl before the next row
.wrap


.program blinky_ctrl

; Inter-row blank dead time, in ~53ns units (0-31). Held blank-high after the
; new row is selected and latched but before it lights, giving the just-
; deselected row time to fully turn off. Raise to clear inter-row ghosting,
; lower to recover a little brightness.
.define ROW_SETTLE 12

; OSR: one BCD tick count per phase (autopull off, explicit pull, reused via
; mov). X: row counter. Y: BCD delay / settle scratch.

.wrap_target
    pull block                          ; tick count for this phase -> OSR
    set x, 30                           ; ROW_COUNT - 1 (31 rows)

    ; inject the single '1' that walks the row-select shift register, selecting
    ; row 0. blank (bit1) stays high throughout so nothing is lit yet.
    set pins, 0b0110                    ; blank high, row data high, clock low
    set pins, 0b1110 [1]                ; row clock high (shift the 1 in)
    set pins, 0b0010                    ; row clock low, row data low

row:
    wait 1 irq 4                        ; DATA_READY: column register holds this row
    set pins, 0b0011 [5]               ; latch high, blank high
    set pins, 0b0010                   ; latch low, blank high
    set y, ROW_SETTLE                   ; blank-high dead time so the old row
settle:                                 ; is fully off before this one lights
    jmp y-- settle [7]                  ; ROW_SETTLE * 8 cycles
    mov y, osr                         ; fresh BCD delay from the tick count
    set pins, 0b0000                   ; blank low: this row is lit
    ; to overlap the next shift with this display, move the irq set 5 to here
bcd:
    jmp y-- bcd
    set pins, 0b0010                   ; blank high: this row is dark
    irq set 5                          ; SHIFT_NEXT: release data SM
    set pins, 0b1010 [1]               ; row clock high (walk select to next row)
    set pins, 0b0010                   ; row clock low
    jmp x-- row
.wrap
